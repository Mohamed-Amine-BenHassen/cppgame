{
  "name": "tower-of-turing-tablet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tower of Turing - the tablet edition. Learn C++ by climbing a tower, compiled in the browser.",
  "scripts": {
    "setup": "node tools/fetch-toolchain.mjs",
    "bake": "node tools/bake-levels.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tools/test-grader.mjs",
    "verify": "node tools/verify.mjs",
    "verify:starters": "node tools/verify.mjs --start",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2"
  }
}
